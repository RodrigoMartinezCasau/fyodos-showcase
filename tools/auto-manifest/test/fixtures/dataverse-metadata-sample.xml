        <Property Name="telephone1" Type="Edm.String"/>
        <Property Name="revenue" Type="Edm.Decimal"/>
        <Property Name="_ownerid_value" Type="Edm.Guid"/>
      </EntityType>
      <EntityType Name="opportunity">
        <Key>
          <PropertyRef Name="opportunityid"/>
        </Key>
        <Property Name="opportunityid" Type="Edm.Guid" Nullable="false"/>
        <Property Name="name" Type="Edm.String" Nullable="false"/>
        <Property Name="estimatedvalue" Type="Edm.Decimal"/>
      </EntityType>
      <Action Name="WinOpportunity" IsBound="true">
        <Parameter Name="entity" Type="mscrm.opportunity" Nullable="false"/>
        <Parameter Name="Status" Type="Edm.Int32" Nullable="false"/>
