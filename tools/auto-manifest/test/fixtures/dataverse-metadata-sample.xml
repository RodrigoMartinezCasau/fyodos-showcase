      </Action>
      <Function Name="WhoAmI">
        <ReturnType Type="mscrm.WhoAmIResponse" Nullable="false"/>
      </Function>
      <Function Name="GetTimeZoneCodeByLocalizedName">
        <Parameter Name="LocalizedStandardName" Type="Edm.String" Nullable="false"/>
