{
  "name": "@fiodos/cli",
  "version": "0.1.28",
  "description": "Fiodos CLI — analyzes your app's source code and generates the in-app voice-agent manifest, then wires the orb. Powers `npx @fiodos/cli analyze`.",
  "type": "commonjs",
  "bin": {
    "fiodos": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "!src/prompts.dev.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "analyze": "node src/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fiodos/core": "^0.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  }
}
