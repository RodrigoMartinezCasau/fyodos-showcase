{
  "name": "@fiodos/react-native",
  "version": "0.1.19",
  "description": "Fiodos agent React Native bindings — orchestrator hook, UI components, navigation/voice/storage adapters and HTTP client over @fiodos/core.",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "default": "./dist/expo/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fiodos/core": "^0.1.13"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo": "*",
    "expo-audio": "*",
    "expo-asset": "*",
    "expo-file-system": "*",
    "expo-router": "*",
    "expo-speech": "*",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-asset": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
